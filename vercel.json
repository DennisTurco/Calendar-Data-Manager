{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "web_app/wsgi.py": {
      "maxDuration": 60,
      "excludeFiles": "{public/**,web_app/node_modules/**,desktop_app/frames/**,desktop_app/CTk*/**,docs/**,dist/**,build/**,**/__pycache__/**}"
    }
  },
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
